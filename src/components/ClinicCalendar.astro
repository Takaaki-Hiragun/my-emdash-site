
---

interface Props {
  scheduleChanges?: Array<{
    data: Record<string, unknown>;
  }>;
}

const { scheduleChanges = [] } = Astro.props;

const getDateKey = (value: unknown): string | null => {
  if (typeof value !== "string" && !(value instanceof Date)) {
    return null;
  }

  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return null;

  const parts = new Intl.DateTimeFormat("en-GB", {
    timeZone: "Asia/Tokyo",
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  }).formatToParts(date);

  const get = (type: string) =>
    parts.find((part) => part.type === type)?.value;

  return `${get("year")}-${get("month")}-${get("day")}`;
};

type CalendarChange = {
  target: string;
  changeType: string;
  note: string;
};

const changesByDate = new Map<string, CalendarChange[]>();

for (const entry of scheduleChanges) {
  const data = entry.data;
  const dateKey = getDateKey(data.change_date);

  if (!dateKey) continue;

  const target =
    typeof data.target === "string" ? data.target : "";
  const changeType =
    typeof data.change_type === "string" ? data.change_type : "";
  const note =
    typeof data.note === "string" ? data.note : "";

  if (!target || !changeType) continue;

  const changes = changesByDate.get(dateKey) ?? [];
  changes.push({ target, changeType, note });
  changesByDate.set(dateKey, changes);
}

const getChangesForDay = (
  year: number,
  month: number,
  day: number
): CalendarChange[] => {
  const key = `${year}-${String(month).padStart(2, "0")}-${String(day).padStart(2, "0")}`;
  return changesByDate.get(key) ?? [];
};

const isHolidayDuty = (
  year: number,
  month: number,
  day: number
): boolean => {
  return getChangesForDay(year, month, day).some(
    (change) =>
      change.target === "クリニック全体" &&
      change.changeType === "休日当番"
  );
};

const days = [
  { day: "月", am: "院長・副院長", pm: "院長" },
  { day: "火", am: "院長・副院長", pm: "院長" },
  { day: "水", am: "院長・副院長", pm: "院長" },
  { day: "木", am: "院長", pm: "休診" },
  { day: "金", am: "院長・副院長", pm: "院長" },
  { day: "土", am: "院長・副院長", pm: "休診" },
  { day: "日", am: "休診", pm: "休診" },
];

const japaneseHolidays = {
  // 2026年
  "2026-01-01": "元日",
  "2026-01-12": "成人の日",
  "2026-02-11": "建国記念の日",
  "2026-02-23": "天皇誕生日",
  "2026-03-20": "春分の日",
  "2026-04-29": "昭和の日",
  "2026-05-03": "憲法記念日",
  "2026-05-04": "みどりの日",
  "2026-05-05": "こどもの日",
  "2026-05-06": "振替休日",
  "2026-07-20": "海の日",
  "2026-08-11": "山の日",
  "2026-09-21": "敬老の日",
  "2026-09-22": "国民の休日",
  "2026-09-23": "秋分の日",
  "2026-10-12": "スポーツの日",
  "2026-11-03": "文化の日",
  "2026-11-23": "勤労感謝の日",

  // 2027年
  "2027-01-01": "元日",
  "2027-01-11": "成人の日",
  "2027-02-11": "建国記念の日",
  "2027-02-23": "天皇誕生日",
  "2027-03-21": "春分の日",
  "2027-03-22": "振替休日",
  "2027-04-29": "昭和の日",
  "2027-05-03": "憲法記念日",
  "2027-05-04": "みどりの日",
  "2027-05-05": "こどもの日",
  "2027-07-19": "海の日",
  "2027-08-11": "山の日",
  "2027-09-20": "敬老の日",
  "2027-09-23": "秋分の日",
  "2027-10-11": "スポーツの日",
  "2027-11-03": "文化の日",
  "2027-11-23": "勤労感謝の日",
};

const getHolidayName = (year: number, month: number, day: number) => {
  const key = `${year}-${String(month).padStart(2, "0")}-${String(day).padStart(2, "0")}`;
  return (japaneseHolidays as Record<string, string>)[key] ?? null;
};

const dateParts = new Intl.DateTimeFormat("ja-JP", {
  timeZone: "Asia/Tokyo",
  year: "numeric",
  month: "numeric",
}).formatToParts(new Date());

const currentYear = Number(
  dateParts.find((p) => p.type === "year")?.value
);
const currentMonth = Number(
  dateParts.find((p) => p.type === "month")?.value
);

const firstWeekday = new Date(
  Date.UTC(currentYear, currentMonth - 1, 1)
).getUTCDay();

const daysInMonth = new Date(
  Date.UTC(currentYear, currentMonth, 0)
).getUTCDate();

const calendarCells = Array.from(
  { length: firstWeekday + daysInMonth },
  (_, i) => i < firstWeekday ? null : i - firstWeekday + 1
);

const nextMonthDate = new Date(
  Date.UTC(currentYear, currentMonth, 1)
);

const nextYear = nextMonthDate.getUTCFullYear();
const nextMonth = nextMonthDate.getUTCMonth() + 1;

const nextFirstWeekday = new Date(
  Date.UTC(nextYear, nextMonth - 1, 1)
).getUTCDay();

const nextDaysInMonth = new Date(
  Date.UTC(nextYear, nextMonth, 0)
).getUTCDate();

const nextCalendarCells = Array.from(
  { length: nextFirstWeekday + nextDaysInMonth },
  (_, i) => i < nextFirstWeekday ? null : i - nextFirstWeekday + 1
);

---

<section class="clinic-calendar">
  <h2>診療時間・担当医</h2>
  <p>通常の診療担当</p>

  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>時間帯</th>
          {days.map((d) => <th>{d.day}</th>)}
        </tr>
      </thead>
      <tbody>
        <tr>
          <th>午前</th>
          {days.map((d) => <td>{d.am}</td>)}
        </tr>
        <tr>
          <th>午後</th>
          {days.map((d) => <td>{d.pm}</td>)}
        </tr>
      </tbody>
    </table>
  </div>

  <p class="note">
    日曜・祝日は原則休診です。
    休日当番や臨時の診療変更は別途お知らせします。
  </p>

  
  <div class="monthly-calendar">
    <div class="monthly-calendar-switch">
      <button type="button" data-month="current" aria-pressed="true">
        今月（{currentMonth}月）
      </button>
      <button type="button" data-month="next" aria-pressed="false">
        翌月（{nextMonth}月）
      </button>
    </div>

    <div data-month-panel="current">
      <h3>{currentYear}年{currentMonth}月の診療カレンダー</h3>

      <div class="monthly-calendar-grid">
        {["日", "月", "火", "水", "木", "金", "土"].map((day) => (
          <div class="monthly-calendar-weekday">{day}</div>
        ))}

       
{calendarCells.map((day, index) => (
  <div class="monthly-calendar-day">
    {day ?? ""}

{day !== null &&
  getChangesForDay(currentYear, currentMonth, day).map(
    (change) => (    
  <div class={
    change.target === "クリニック全体" &&
    ["午前休診", "午後休診", "終日休診"].includes(change.changeType)
      ? "calendar-change calendar-change--closed"
      : "calendar-change"
  }>
    {change.target}：{change.changeType}
    {change.note && (
          <div class="calendar-change-note">
            {change.note}
          </div>
        )}
      </div>
    )
  )}

    
{day !== null &&
  !isHolidayDuty(currentYear, currentMonth, day) &&
  (index % 7 === 0 ||
    getHolidayName(currentYear, currentMonth, day)) && (

        <div class="calendar-closed">
          {getHolidayName(currentYear, currentMonth, day) ?? "日曜"}・休診
        </div>
      )}
  </div>
))}

      </div>
    </div>

    <div data-month-panel="next" hidden>
      <h3>{nextYear}年{nextMonth}月の診療カレンダー</h3>

      <div class="monthly-calendar-grid">
        {["日", "月", "火", "水", "木", "金", "土"].map((day) => (
          <div class="monthly-calendar-weekday">{day}</div>
        ))}

        
{nextCalendarCells.map((day, index) => (
  <div class="monthly-calendar-day">
    {day ?? ""}

{day !== null &&
  getChangesForDay(nextYear, nextMonth, day).map(
    (change) => (
    
<div class={
  change.target === "クリニック全体" &&
  ["午前休診", "午後休診", "終日休診"].includes(change.changeType)
    ? "calendar-change calendar-change--closed"
    : "calendar-change"
}>
  
        {change.target}：{change.changeType}
        {change.note && (
          <div class="calendar-change-note">
            {change.note}
          </div>
        )}
      </div>
    )
  )}

    
{day !== null &&
  !isHolidayDuty(nextYear, nextMonth, day) &&
  (index % 7 === 0 ||
    getHolidayName(nextYear, nextMonth, day)) && (

        <div class="calendar-closed">
          {getHolidayName(nextYear, nextMonth, day) ?? "日曜"}・休診
        </div>
      )}
  </div>
))}

      </div>
    </div>
  </div>


</section>

<style>
  .clinic-calendar {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 24px;
  }

  .clinic-calendar h2 {
    font-size: 1.8rem;
    margin-bottom: 16px;
  }

  .table-scroll {
    overflow-x: auto;
    margin-top: 20px;
  }

  table {
    width: 100%;
    min-width: 700px;
    border-collapse: collapse;
    text-align: center;
  }

  th, td {
    border: 1px solid #ddd;
    padding: 14px 8px;
    font-size: 0.9rem;
  }

  thead th {
    background: #f3f5f1;
  }

  tbody th {
    background: #f8f8f8;
  }

  .note {
    margin-top: 16px;
    color: #666;
    font-size: 0.85rem;
  }

  /* 月間診療カレンダー */
  .monthly-calendar {
    margin-top: 40px;
  }

  .monthly-calendar h3 {
    font-size: 1.4rem;
    margin-bottom: 20px;
  }

  .monthly-calendar-grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 4px;
  }

  .monthly-calendar-weekday {
    text-align: center;
    font-weight: bold;
    padding: 10px 0;
    background: #f3f5f1;
  }

  .monthly-calendar-day {
    min-height: 70px;
    padding: 10px;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 0.95rem;
  }

  .monthly-calendar-day:empty {
    background: #f8f8f8;
  }

  @media (max-width: 600px) {
    .monthly-calendar-grid {
      gap: 2px;
    }

    .monthly-calendar-day {
      min-height: 48px;
      padding: 5px;
      font-size: 0.8rem;
    }

    .monthly-calendar-weekday {
      padding: 8px 0;
      font-size: 0.8rem;
    }
  }

  /* 月の切り替えボタン */
  .monthly-calendar-switch {
    display: flex;
    gap: 10px;
    margin-bottom: 20px;
  }

  .monthly-calendar-switch button {
    padding: 10px 20px;
    border: 1px solid #ccc;
    border-radius: 8px;
    background: #f5f5f5;
    color: #333;
    font-size: 1rem;
    cursor: pointer;
  }

  .monthly-calendar-switch button[aria-pressed="true"] {
    background: #5b8b57;
    border-color: #5b8b57;
    color: white;
    font-weight: bold;
  }

  .monthly-calendar-switch button:focus-visible {
    outline: 2px solid #333;
    outline-offset: 3px;
  }

  /* 日曜日・祝日の休診表示 */
  .monthly-calendar-day:has(.calendar-closed) {
    background: #fff2f1;
    border-color: #ebcbc8;
  }

  .calendar-closed {
    margin-top: 8px;
    color: #a24040;
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.5;
  }

  @media (max-width: 600px) {
    .calendar-closed {
      font-size: 0.7rem;
      margin-top: 4px;
    }
  }

  /* 診療予定変更の表示 */
  .calendar-change {
    margin-top: 6px;
    padding: 6px 8px;
    background: #eaf2fa;
    border-left: 3px solid #5683ad;
    border-radius: 4px;
    color: #285477;
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .calendar-change-note {
    margin-top: 4px;
    font-size: 0.75rem;
    font-weight: normal;
    color: #45657d;
  }

/* クリニック全体の休診 */
.calendar-change--closed {
  background: #fff0ee;
  border-left-color: #c45858;
  color: #a33d3d;
}

.calendar-change--closed .calendar-change-note {
  color: #a35b58;
}

  @media (max-width: 600px) {
    .calendar-change {
      padding: 4px;
      font-size: 0.7rem;
    }
  }

</style>

<script>
  document.querySelectorAll(".monthly-calendar").forEach((calendar) => {
    const buttons = calendar.querySelectorAll("button[data-month]");
    const panels = calendar.querySelectorAll("[data-month-panel]");

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const selected = button.getAttribute("data-month");

        panels.forEach((panel) => {
          panel.toggleAttribute(
            "hidden",
            panel.getAttribute("data-month-panel") !== selected
          );
        });

        buttons.forEach((item) => {
          item.setAttribute("aria-pressed", String(item === button));
        });
      });
    });
  });
</script>
