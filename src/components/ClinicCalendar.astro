
---
const days = [
  { day: "月", am: "院長・副院長", pm: "院長" },
  { day: "火", am: "院長・副院長", pm: "院長" },
  { day: "水", am: "院長・副院長", pm: "院長" },
  { day: "木", am: "院長", pm: "休診" },
  { day: "金", am: "院長・副院長", pm: "院長" },
  { day: "土", am: "院長・副院長", pm: "休診" },
  { day: "日", am: "休診", pm: "休診" },
];

const dateParts = new Intl.DateTimeFormat("ja-JP", {
  timeZone: "Asia/Tokyo",
  year: "numeric",
  month: "numeric",
}).formatToParts(new Date());

const currentYear = Number(
  dateParts.find((p) => p.type === "year")?.value
);
const currentMonth = Number(
  dateParts.find((p) => p.type === "month")?.value
);

const firstWeekday = new Date(
  Date.UTC(currentYear, currentMonth - 1, 1)
).getUTCDay();

const daysInMonth = new Date(
  Date.UTC(currentYear, currentMonth, 0)
).getUTCDate();

const calendarCells = Array.from(
  { length: firstWeekday + daysInMonth },
  (_, i) => i < firstWeekday ? null : i - firstWeekday + 1
);

---

<section class="clinic-calendar">
  <h2>診療時間・担当医</h2>
  <p>通常の診療担当</p>

  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>時間帯</th>
          {days.map((d) => <th>{d.day}</th>)}
        </tr>
      </thead>
      <tbody>
        <tr>
          <th>午前</th>
          {days.map((d) => <td>{d.am}</td>)}
        </tr>
        <tr>
          <th>午後</th>
          {days.map((d) => <td>{d.pm}</td>)}
        </tr>
      </tbody>
    </table>
  </div>

  <p class="note">
    日曜・祝日は原則休診です。
    休日当番や臨時の診療変更は別途お知らせします。
  </p>

  <div class="monthly-calendar">
    <h3>{currentYear}年{currentMonth}月の診療カレンダー</h3>

    <div class="monthly-calendar-grid">
      {["日", "月", "火", "水", "木", "金", "土"].map((day) => (
        <div class="monthly-calendar-weekday">{day}</div>
      ))}

      {calendarCells.map((day) => (
        <div class="monthly-calendar-day">
          {day ?? ""}
        </div>
      ))}
    </div>
  </div>

</section>

<style>
  .clinic-calendar {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 24px;
  }

  .clinic-calendar h2 {
    font-size: 1.8rem;
    margin-bottom: 16px;
  }

  .table-scroll {
    overflow-x: auto;
    margin-top: 20px;
  }

  table {
    width: 100%;
    min-width: 700px;
    border-collapse: collapse;
    text-align: center;
  }

  th, td {
    border: 1px solid #ddd;
    padding: 14px 8px;
    font-size: 0.9rem;
  }

  thead th {
    background: #f3f5f1;
  }

  tbody th {
    background: #f8f8f8;
  }

  .note {
    margin-top: 16px;
    color: #666;
    font-size: 0.85rem;
  }

  /* 月間診療カレンダー */
  .monthly-calendar {
    margin-top: 40px;
  }

  .monthly-calendar h3 {
    font-size: 1.4rem;
    margin-bottom: 20px;
  }

  .monthly-calendar-grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 4px;
  }

  .monthly-calendar-weekday {
    text-align: center;
    font-weight: bold;
    padding: 10px 0;
    background: #f3f5f1;
  }

  .monthly-calendar-day {
    min-height: 70px;
    padding: 10px;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 0.95rem;
  }

  .monthly-calendar-day:empty {
    background: #f8f8f8;
  }

  @media (max-width: 600px) {
    .monthly-calendar-grid {
      gap: 2px;
    }

    .monthly-calendar-day {
      min-height: 48px;
      padding: 5px;
      font-size: 0.8rem;
    }

    .monthly-calendar-weekday {
      padding: 8px 0;
      font-size: 0.8rem;
    }
  }

</style>
