---
import {
	getEmDashCollection,
	getTermsForEntries,
	getSiteSettings,
	type PortableTextBlock,
} from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import ClinicCalendar from "../components/ClinicCalendar.astro";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

// Limit to what we render (1 featured + 6 grid). The DB does the slicing
// instead of fetching every post and discarding the tail in JS.
const POSTS_PER_PAGE = 7;

const [{ entries: posts, cacheHint }, settings, notices, scheduleChanges] = await Promise.all([
	getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: POSTS_PER_PAGE + 1, // +1 to detect "view all" need
	}),
	getSiteSettings(),
	
    getEmDashCollection("notices", {
      status: "published",
      orderBy: { published_at: "desc" },
    }),
    getEmDashCollection("schedule_changes", {
      status: "published",
    }),
  ]);

const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);


if (notices.error) console.error("Failed to load notices:", notices.error);
if (scheduleChanges.error) {
  console.error("Failed to load schedule changes:", scheduleChanges.error);
}

if (Astro.cache?.enabled) {
  const tags = new Set([
    ...(cacheHint.tags ?? []),
    ...(notices.cacheHint.tags ?? []),
    ...(scheduleChanges.cacheHint.tags ?? []),
  ]);

  Astro.cache.set(
    notices.error || scheduleChanges.error
      ? false
      : { ...cacheHint, tags: [...tags] }
  );
}


const noticeDateFormat = new Intl.DateTimeFormat("ja-JP", {
	dateStyle: "long",
	timeZone: "Asia/Tokyo",
});
const publishedNotices = notices.entries.map(({ data }) => {
	const publishedAt: unknown = data.publishedAt;
	let date: Date | null = null;
	if (publishedAt instanceof Date) date = publishedAt;
	if (typeof publishedAt === "string") date = new Date(publishedAt);
	return {
		title: typeof data.title === "string" ? data.title : "",
		body: Array.isArray(data.body) ? (data.body as PortableTextBlock[]) : [],
		date: date && Number.isFinite(date.getTime()) ? date : null,
	};
});

// Trim the lookahead post used to detect overflow
const visiblePosts = posts.slice(0, POSTS_PER_PAGE);
const hasMorePosts = posts.length > POSTS_PER_PAGE;

// Find the first post with a featured image for the hero
const featuredPost = visiblePosts.find((p) => p.data.featured_image);
const featuredIndex = featuredPost ? visiblePosts.indexOf(featuredPost) : -1;

// Get remaining posts (exclude featured if found, limit to 6 for grid)
const gridPosts = visiblePosts
	.filter((_, i) => i !== featuredIndex)
	.slice(0, 6);

// Single batched query for tags across the featured post + grid posts.
// Avoids the N+1 pattern of calling getEntryTerms() per entry.
// Bylines are already hydrated on entry.data.bylines by getEmDashCollection.
const tagEntryIds = [
	...(featuredPost ? [featuredPost.data.id] : []),
	...gridPosts.map((p) => p.data.id),
];
const tagsByEntry = await getTermsForEntries("posts", tagEntryIds, "tag");

const featuredTags = featuredPost
	? (tagsByEntry.get(featuredPost.data.id) ?? []).map((t) => ({
			slug: t.slug,
			label: t.label,
		}))
	: [];

const gridPostsWithTags = gridPosts.map((post) => ({
	post,
	tags: (tagsByEntry.get(post.data.id) ?? []).map((t) => ({
		slug: t.slug,
		label: t.label,
	})),
}));
---

<Base title={siteTitle} description={siteTagline}>

<div class="home-hero">
    <img
        src="/_emdash/api/media/file/01M7SXPDDFZXPSYMCKV3AQA264.01M7SXPEQAA7RDGQDZXHH8VQ6K.png"
        alt="花々が描かれたクリニックのメイン画像"
        width="1405"
        height="572"
        style="display: block; width: 100%; height: clamp(220px, 30vw, 460px); object-fit: cover; object-position: center;"
    />
</div>

	<header class="band intro">
		<div class="frame home-intro">
			<div>
				<p class="eyebrow">皮膚科・アレルギー科</p>
				<h1 class="intro__title">{siteTitle}</h1>
				{siteTagline && <p class="intro__subtitle">{siteTagline}</p>}
			</div>
			<a
				href="/rss.xml"
				type="application/rss+xml"
				class="btn btn--ghost btn--sm home-intro__rss"
			>
				<svg
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.75"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M4 11a9 9 0 0 1 9 9"></path>
					<path d="M4 4a16 16 0 0 1 16 16"></path>
					<circle cx="5" cy="19" r="1"></circle>
				</svg>
				RSS feed
			</a>
		</div>
	</header>
	
<ClinicCalendar scheduleChanges={scheduleChanges.entries} />

	<section class="band section" aria-labelledby="clinic-notices">
		<div class="frame">
			<div class="section-head">
				<h2 id="clinic-notices" class="section-head__title">クリニックからのお知らせ</h2>
			</div>
			{notices.error && <p>ただいまお知らせを表示できません。</p>}
			{!notices.error && publishedNotices.length === 0 && <p>現在、お知らせはありません。</p>}
			{publishedNotices.length > 0 && (
				<ul class="clinic-notices">
					{publishedNotices.map(({ title, body, date }) => (
						<li>
							<article>
								{date && <time datetime={date.toISOString()}>{noticeDateFormat.format(date)}</time>}
								<h3>{title}</h3>
								{body.length > 0 && <PortableText value={body} />}
							</article>
						</li>
					))}
				</ul>
			)}
		</div>
	</section>

	{
		posts.length > 0 && (
			<>
				{featuredPost && (
					<section class="band section">
						<div class="frame">
							<PostCard
								post={featuredPost}
								tags={featuredTags}
								variant="feature"
								headingLevel={2}
								priority
							/>
						</div>
					</section>
				)}

				{gridPostsWithTags.length > 0 && (
					<section class="band section" aria-labelledby="latest-posts">
						<div class="frame">
							<div class="section-head">
								<h2 id="latest-posts" class="section-head__title">
									Latest posts
								</h2>
								{hasMorePosts && (
									<a href="/posts" class="arrow-link">
										View all<span class="sr-only"> posts</span>
										<svg
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="1.75"
											stroke-linecap="round"
											stroke-linejoin="round"
											aria-hidden="true"
										>
											<path d="M5 12h14" />
											<path d="m12 5 7 7-7 7" />
										</svg>
									</a>
								)}
							</div>
							<div class="post-grid">
								{gridPostsWithTags.map(({ post, tags }) => (
									<PostCard
										post={post}
										tags={tags}
										variant="card"
										headingLevel={3}
									/>
								))}
							</div>
						</div>
					</section>
				)}
			</>
		)
	}
</Base>

<style>
	.clinic-notices {
		list-style: none;
		padding: 0;
	}

	.clinic-notices > li {
		padding-block: var(--spacing-4);
		border-block-end: 1px solid var(--color-border);
	}

	.home-intro {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: end;
		gap: var(--spacing-6) var(--spacing-8);
	}

	/* Lifts the pill from the line box's bottom onto the last line's baseline */
	.home-intro__rss {
		margin-block-end: var(--spacing-2);
	}

	@media (max-width: 720px) {
		.home-intro {
			grid-template-columns: minmax(0, 1fr);
		}

		.home-intro__rss {
			justify-self: start;
			margin-block-end: 0;
		}

  .intro__title {
    font-size: clamp(1.375rem, 5.5vw, 1.75rem);
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

}
</style>
